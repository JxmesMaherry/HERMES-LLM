{
  "name": "hermes-llm",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @hermes/desktop",
    "desktop": "npm run tauri --workspace @hermes/desktop -- dev",
    "build": "npm run build --workspace @hermes/desktop",
    "dmg": "npm run tauri --workspace @hermes/desktop -- build --target aarch64-apple-darwin --bundles app,dmg",
    "lint": "npm run lint --workspace @hermes/desktop",
    "typecheck": "npm run typecheck --workspace @hermes/desktop",
    "test": "npm run test --workspace @hermes/desktop && node --test tests/*.test.mjs",
    "format": "npm run format --workspace @hermes/desktop",
    "format:check": "npm run format:check --workspace @hermes/desktop",
    "stress": "node scripts/stress-test.mjs"
  }
}
